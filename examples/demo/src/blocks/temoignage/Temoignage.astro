---
import { pick, type BlockProps } from '@leobernard/basalte'
import schema from './schema.js'

type Props = BlockProps<(typeof schema)['fields']>

const { props, language } = Astro.props
---

<figure class="temoignage">
  <blockquote class="temoignage__quote">
    {pick(props.quote, language)}
  </blockquote>
  <figcaption class="temoignage__author">{props.author}</figcaption>
</figure>

<style>
  .temoignage {
    margin: 0;
    padding-block: clamp(var(--space-7), 6vw, var(--space-9));
    padding-inline: var(--space-5);
    background: var(--color-bg);
    text-align: center;
  }

  .temoignage__quote {
    max-width: var(--width-content);
    margin: 0 auto var(--space-4);
    font-family: var(--font-title);
    font-size: clamp(var(--text-xl), 3.5vw, var(--text-2xl));
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .temoignage__author {
    max-width: var(--width-content);
    margin-inline: auto;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
</style>
