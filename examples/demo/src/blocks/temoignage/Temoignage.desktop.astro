---
// La variante bureau d’un bloc du dépôt : la citation prend toute la largeur,
// et l’auteur passe à côté d’elle plutôt qu’en dessous. Aucune media query —
// ce fichier n’est servi qu’au bureau.
import { pick, type BlockProps } from '@leobernard/basalte'
import schema from './schema.js'

type Props = BlockProps<(typeof schema)['fields']>

const { props, language } = Astro.props
---

<figure class="temoignage">
  <div class="temoignage__inner">
    <blockquote class="temoignage__quote">
      {pick(props.quote, language)}
    </blockquote>
    <figcaption class="temoignage__author">{props.author}</figcaption>
  </div>
</figure>

<style>
  .temoignage {
    margin: 0;
    padding-block: var(--space-9);
    padding-inline: var(--space-5);
    background: var(--color-bg);
  }

  .temoignage__inner {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
    align-items: end;
    gap: var(--space-7);
    max-width: var(--width-wide);
    margin-inline: auto;
  }

  .temoignage__quote {
    margin: 0;
    font-family: var(--font-title);
    font-size: clamp(var(--text-xl), 3vw, var(--text-3xl));
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .temoignage__author {
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-align: right;
  }
</style>
