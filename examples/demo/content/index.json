    {
      "id": "garanties",
      "type": "bento",
      "props": {
        "title": {
          "fr": "Ce qui ne bougera pas",
          "en": ""
        },
        "intro": {
          "fr": "Ce ne sont pas des options : c’est ce que le socle refuse de faire autrement, sur tous les sites qu’il porte.",
          "en": ""
        },
        "items": [
          {
            "title": {
              "fr": "Aucun script sur vos pages",
              "en": ""
            },
            "body": {
              "fr": "Une page de votre site ne charge aucun JavaScript. Elle s’affiche à l’instant où elle arrive, même sur un téléphone au bord du réseau.",
              "en": ""
            },
            "image": "",
            "size": "large"
          },
          {
            "title": {
              "fr": "Pas de traceur, pas de bandeau",
              "en": ""
            },
            "body": {
              "fr": "L’audience se mesure dans les journaux du serveur. Aucun cookie à annoncer, aucune régie tierce.",
              "en": ""
            },
            "image": "",
            "size": "normal"
          },
          {
            "title": {
              "fr": "Vos textes vous appartiennent",
              "en": ""
            },
            "body": {
              "fr": "Ils vivent en fichiers dans votre dépôt, lisibles sans nous. Rien n’est enfermé dans une base.",
              "en": ""
            },
            "image": "",
            "size": "normal"
          },
          {
            "title": {
              "fr": "Pas d’abonnement à une plateforme",
              "en": ""
            },
            "body": {
              "fr": "Vous payez un hébergement, pas un droit d’accès à votre propre site. Le jour où vous partez, il part avec vous.",
              "en": ""
            },
            "image": "",
            "size": "normal"
          },
          {
            "title": {
              "fr": "Vos messages arrivent chez vous",
              "en": ""
            },
            "body": {
              "fr": "Le formulaire écrit dans votre boîte mail et garde une copie. Rien ne transite par un service tiers.",
              "en": ""
            },
            "image": "",
            "size": "normal"
