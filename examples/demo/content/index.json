          {
            "title": {
              "fr": "Les images sont préparées d’avance",
              "en": ""
            },
            "body": {
              "fr": "Cinq largeurs en WebP produites au dépôt de l’image, jamais au moment de la publication.",
              "en": ""
            }
          },
          {
            "title": {
              "fr": "Une publication ratée ne casse rien",
              "en": ""
            },
            "body": {
              "fr": "Le contenu est validé contre son schéma avant que quoi que ce soit ne parte en ligne.",
              "en": ""
            }
