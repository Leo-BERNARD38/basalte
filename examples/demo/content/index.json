    {
      "id": "q1",
      "type": "faq",
      "props": {
        "title": {
          "fr": "Questions fréquentes",
          "en": ""
        },
        "items": [
          {
            "question": {
              "fr": "Puis-je modifier moi-même les textes ?",
              "en": ""
            },
            "answer": {
              "fr": "Oui. Chaque section s’édite depuis le panel, et **rien n’est en ligne** tant que vous n’avez pas cliqué sur « Mettre en ligne ».",
              "en": ""
            }
          },
          {
            "question": {
              "fr": "Et si je casse quelque chose ?",
              "en": ""
            },
            "answer": {
              "fr": "Un enregistrement invalide est refusé avant d’être écrit, et chaque version reste en place tant que la suivante n’est pas construite.",
              "en": ""
            }
          },
          {
            "question": {
              "fr": "Ce bloc charge-t-il du JavaScript ?",
              "en": ""
            },
            "answer": {
              "fr": "Non. Le dépliage est celui de `details`, natif :\n\n- le clavier l’ouvre\n- les lecteurs d’écran l’annoncent\n- la recherche de la page y trouve le texte replié",
              "en": ""
            }
          }
        ]
      }
