---
// Le pied de page, rendu mobile — celui qui existe toujours (D104).
//
// Il ne porte que ce qui n’est écrit nulle part ailleurs : les liens légaux,
// le nom du site et l’année. L’adresse, le téléphone et la raison sociale
// vivent dans les mentions légales, qui en sont la seule source (D101) — les
// ressaisir ici en ferait une seconde, et les deux divergeraient.
//
// Ses liens ne se devinent pas : une liste vide rend un pied sans liens. Ce
// que l’en-tête déduit — les pages du site — n’a pas de sens ici, où seules
// deux ou trois pages ont leur place.
import { urlFor } from '../../astro/routes.js'
import type { ChromeProps } from '../define.js'
import { navigationLinks } from '../links.js'
import schema from './schema.js'

type Props = ChromeProps<(typeof schema)['fields']>

const { props, language, site, pages, route } = Astro.props

const prefix = language === site.languages.default.code ? '' : language

const links = navigationLinks({
  links: props.links,
  pages,
  language,
  prefix,
  route,
  whenEmpty: 'nothing',
})

const year = new Date().getFullYear()
---

<footer class="chrome-footer">
  {
    links.length > 0 && (
      <nav class="chrome-footer__nav" aria-label="Liens légaux">
        <ul class="chrome-footer__list">
          {links.map((link) => (
            <li>
              <a
                class="chrome-footer__link"
                href={link.href}
                aria-current={link.current ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
  <p class="chrome-footer__note">
    © {year}
    <a class="chrome-footer__link" href={urlFor('/', prefix)}>{site.name}</a>
  </p>
</footer>

<style>
  .chrome-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding: var(--space-6) var(--space-5);
    background: var(--color-bg);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .chrome-footer__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chrome-footer__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
  }

  .chrome-footer__link:hover,
  .chrome-footer__link[aria-current='page'] {
    text-decoration: underline;
  }

  .chrome-footer__note {
    margin: 0;
  }

  .chrome-footer__note .chrome-footer__link {
    min-height: 0;
  }
</style>
