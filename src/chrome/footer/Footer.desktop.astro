---
// La variante bureau du pied de page : les mêmes liens, sur une ligne, la
// mention de propriété à l’opposé.
//
// Rien qui ne soit dans le rendu mobile — mêmes liens, même mention, même
// année (`src/render/parity.ts`, D108).
import { urlFor } from '../../astro/routes.js'
import type { ChromeProps } from '../define.js'
import { navigationLinks } from '../links.js'
import schema from './schema.js'

type Props = ChromeProps<(typeof schema)['fields']>

const { props, language, site, pages, route } = Astro.props

const prefix = language === site.languages.default.code ? '' : language

const links = navigationLinks({
  links: props.links,
  pages,
  language,
  prefix,
  route,
  whenEmpty: 'nothing',
})

const year = new Date().getFullYear()
---

<footer class="chrome-footer">
  <div class="chrome-footer__inner">
    <p class="chrome-footer__note">
      © {year}{' '}
      <a class="chrome-footer__link" href={urlFor('/', prefix)}>{site.name}</a>
    </p>
    {
      links.length > 0 && (
        <nav class="chrome-footer__nav" aria-label="Liens légaux">
          <ul class="chrome-footer__list">
            {links.map((link) => (
              <li>
                <a
                  class="chrome-footer__link"
                  href={link.href}
                  aria-current={link.current ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</footer>

<style>
  .chrome-footer {
    margin-top: var(--space-8);
    padding: var(--space-6) var(--space-5);
    background: var(--color-bg);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .chrome-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: var(--width-wide);
    margin-inline: auto;
  }

  .chrome-footer__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chrome-footer__link {
    color: inherit;
    text-decoration: none;
  }

  .chrome-footer__link:hover,
  .chrome-footer__link[aria-current='page'] {
    text-decoration: underline;
  }

  .chrome-footer__note {
    margin: 0;
  }
</style>
