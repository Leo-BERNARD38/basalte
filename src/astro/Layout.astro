---
// L’enveloppe d’une page : ses métadonnées, ses tokens, et le chrome qui
// entoure ses sections.
//
// Les composants du chrome viennent du module généré, comme ceux des blocs :
// c’est ce qui permet à un dépôt client de les remplacer sans qu’une ligne de
// ce fichier change (D45, invariant 8). La variante bureau y retombe sur le
// composant quand elle n’existe pas, exactement comme pour une section.
//
// Son *contenu*, lui, arrive en prop : le module généré n’en porte qu’une
// photographie du démarrage, et l’aperçu du panel doit montrer le dernier
// enregistrement (D96).
//
// C’est ici, et nulle part ailleurs, que se posent la carte de partage et les
// données structurées. Les deux rendus passent par ce même fichier : ils ne
// peuvent donc pas diverger sur ce que Google lit, ce que le contrat de la
// phase 8 exige (D108).
import {
  chrome,
  chromeDesktop,
  journalRegistry,
  registry,
  structured,
} from 'virtual:basalte'

import type { DocumentResolver, ImageResolver } from '../blocks/define.js'
import type { ChromeContent, PageEntry } from '../chrome/define.js'
import type { PageBlock, PageMeta } from '../content/page.js'
import type { PostEntry } from '../journal/page.js'
import { feedPath } from '../journal/feed.js'
import { pick } from '../fields/translate.js'
import { DEFAULT_SUPPORT, type Support } from '../render/supports.js'
import type { BusinessFacts } from '../seo/business.js'
import { shareImageKey, shareTags, type ShareImage } from '../seo/meta.js'
import { pageNodes, renderStructured } from '../seo/structured.js'
import type { Site } from '../site/define.js'
import { tokensToCss } from '../site/tokens.js'
import { urlFor } from './routes.js'
import './base.css'

type Props = {
  site: Site
  meta: PageMeta
  language: string
  route: string
  support: Support
  image: ImageResolver
  document: DocumentResolver
  chrome: ChromeContent
  pages: readonly PageEntry[]
  /** Les sections visibles : elles décident de la carte et du JSON-LD. */
  sections: readonly PageBlock[]
  business: BusinessFacts
  /** Les billets visibles dans cette langue — le chrome les reçoit comme un bloc. */
  posts: readonly PostEntry[]
  /**
   * Faux pour la page 404, qui n’a ni adresse canonique, ni traduction, ni
   * carte de partage : elle n’est le résultat d’aucune recherche.
   */
  indexable?: boolean
}

const {
  site,
  meta,
  language,
  route,
  support,
  image,
  document,
  chrome: content,
  pages,
  sections,
  business,
  posts,
  indexable = true,
} = Astro.props

const origin = `https://${site.domain}`
const title = pick(meta.title, language)
const description = pick(meta.description, language)

const canonical = origin + urlFor(route, prefix(language))
const alternates =
  indexable && site.languages.online.length > 1
    ? site.languages.online.map((entry) => ({
        hreflang: entry.code,
        href: origin + urlFor(route, prefix(entry.code)),
      }))
    : []

function prefix(code: string): string {
  return code === site.languages.default.code ? '' : code
}

// L’image de partage est absolue : une messagerie ne résout pas un chemin. Le
// gabarit du billet entre dans le registre consulté : sans lui, un billet sans
// couverture ne retomberait sur aucune de ses propres images.
const known = { ...registry, ...journalRegistry }

const shared = image(
  shareImageKey({ meta, registry: known, sections }),
  undefined,
)
const card: ShareImage | undefined =
  shared === undefined
    ? undefined
    : {
        src: origin + shared.src,
        width: shared.width,
        height: shared.height,
        alt: shared.alt,
      }

const tags = indexable
  ? shareTags({
      site,
      title,
      description,
      url: canonical,
      language,
      ...(card === undefined ? {} : { image: card }),
    })
  : []

const nodes = indexable
  ? pageNodes({
      site,
      business,
      builders: structured,
      sections,
      route,
      language,
      url: canonical,
    })
  : []

const variants = support === DEFAULT_SUPPORT ? {} : chromeDesktop
const Header = variants['header'] ?? chrome['header']
const Footer = variants['footer'] ?? chrome['footer']

const around = {
  language,
  image,
  document,
  site,
  route,
  pages,
  business,
  posts,
}

// Le flux n’est annoncé que sur un site qui en a un, et jamais sur une page
// que les moteurs n’ont pas à suivre.
const feed =
  indexable && site.journal !== undefined
    ? feedPath(site.journal, language, site.languages)
    : undefined
---

<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description !== '' && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {!indexable && <meta name="robots" content="noindex" />}
    {
      feed !== undefined && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={site.journal?.label}
          href={origin + feed}
        />
      )
    }
    {indexable && <link rel="canonical" href={canonical} />}
    {
      alternates.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate.hreflang}
          href={alternate.href}
        />
      ))
    }
    {
      alternates.length > 0 && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={origin + urlFor(route, '')}
        />
      )
    }
    {
      tags.map((tag) =>
        tag.property === undefined ? (
          <meta name={tag.name} content={tag.content} />
        ) : (
          <meta property={tag.property} content={tag.content} />
        ),
      )
    }
    {
      nodes.map((node) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={renderStructured(node)}
        />
      ))
    }
    <style is:global set:html={tokensToCss(site.tokens)}></style>
  </head>
  <body>
    <Header props={content.header} {...around} />
    <main>
      <slot />
    </main>
    <Footer props={content.footer} {...around} />
  </body>
</html>
