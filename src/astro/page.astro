---
import {
  blocks,
  business,
  chromeContent,
  desktop,
  documents,
  media,
  pages,
  site,
} from 'virtual:basalte'
import { isServiceRoute } from '../content/naming.js'
import { resolveDocument, resolveImage } from '../media/resolve.js'
import { headingOf } from '../render/outline.js'
import { slugIn, supportsOf } from '../render/supports.js'
import Layout from './Layout.astro'
import { slugFor } from './routes.js'

export function getStaticPaths() {
  return pages.flatMap((entry) =>
    site.languages.online.flatMap((language) => {
      const slug = slugFor(
        entry.route,
        language.code === site.languages.default.code ? '' : language.code,
      )

      return supportsOf(site).map((support) => ({
        params: { slug: slugIn(support, slug) },
        props: { entry, language: language.code, support },
      }))
    }),
  )
}

const { entry, language, support } = Astro.props

// Le mobile est le rendu de référence : un bloc sans variante bureau y retombe.
const components = support === 'desktop' ? desktop : {}

const sections = entry.page.blocks.filter(
  (section) => section.hidden[language] !== true,
)

const image = (key: string, sizes?: string) =>
  resolveImage(media, key, language, sizes)

const document = (key: string) => resolveDocument(documents, key)

const around = pages.map((page) => ({ name: page.name, route: page.route }))

// Une page de service est servie, jamais référencée : ni canonique, ni
// traduction, ni carte de partage — la même enveloppe que la page 404.
const indexable = !isServiceRoute(entry.route)
---

<Layout
  site={site}
  meta={entry.page.meta}
  language={language}
  route={entry.route}
  support={support}
  image={image}
  document={document}
  chrome={chromeContent}
  pages={around}
  sections={sections}
  business={business}
  indexable={indexable}
>
  {
    sections.map((section, index) => {
      const Block = components[section.type] ?? blocks[section.type]
      return (
        <Block
          props={section.props}
          language={language}
          image={image}
          document={document}
          heading={headingOf(index)}
        />
      )
    })
  }
</Layout>
