---
import { blocks, desktop, journalBlocks, journalDesktop } from 'virtual:basalte'

import { resolveDocument, resolveImage } from '../media/resolve.js'
import { headingOf } from '../render/outline.js'
import Layout from './Layout.astro'
import { resolvePreview } from './preview.js'
import { panelContext } from './server.js'

export const prerender = false

const view = await resolvePreview(
  panelContext(),
  Astro.request,
  Astro.params.slug ?? '',
)

if (view.kind === 'stop') return view.response

const { entry, language, support, schemas, content, business, pages, posts } =
  view

// Le gabarit du billet entre dans le registre : sinon l’aperçu d’un billet ne
// trouverait pas de composant pour sa seule section.
const components =
  support === 'desktop' ? { ...desktop, ...journalDesktop } : {}
const available = { ...blocks, ...journalBlocks }

const sections = entry.page.blocks.filter(
  (section) => section.hidden[language] !== true,
)

const image = (key: string, sizes?: string) =>
  resolveImage(schemas.media, key, language, sizes)

const document = (key: string) => resolveDocument(schemas.documents, key)
---

<Layout
  site={schemas.site}
  meta={entry.page.meta}
  language={language}
  route={entry.route}
  support={support}
  image={image}
  document={document}
  chrome={content}
  pages={pages}
  sections={sections}
  business={business}
  posts={posts}
>
  {
    /* Chaque section porte son identifiant, pour que le panel l’amène en vue
       et la souligne quand on la choisit dans la liste. L’enveloppe n’existe
       que dans l’aperçu : le site construit ne la porte pas. */
    sections.map((section, index) => {
      const Block = components[section.type] ?? available[section.type]
      return (
        <div id={section.id} data-section>
          <Block
            props={section.props}
            language={language}
            image={image}
            document={document}
            heading={headingOf(index)}
            business={business}
            posts={posts}
          />
        </div>
      )
    })
  }
</Layout>

<style is:global>
  /* La section choisie dans le panel : un trait d’encre à l’intérieur de son
     bord, le temps qu’elle est visée. */
  [data-section]:target {
    box-shadow: inset 0 0 0 3px var(--color-fg);
  }
</style>
