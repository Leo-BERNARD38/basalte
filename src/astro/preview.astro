---
import { blocks, desktop } from 'virtual:basalte'

import { resolveDocument, resolveImage } from '../media/resolve.js'
import { headingOf } from '../render/outline.js'
import Layout from './Layout.astro'
import { resolvePreview } from './preview.js'
import { panelContext } from './server.js'

export const prerender = false

const view = await resolvePreview(
  panelContext(),
  Astro.request,
  Astro.params.slug ?? '',
)

if (view.kind === 'stop') return view.response

const { entry, language, support, schemas, content, business, pages } = view

const components = support === 'desktop' ? desktop : {}

const sections = entry.page.blocks.filter(
  (section) => section.hidden[language] !== true,
)

const image = (key: string, sizes?: string) =>
  resolveImage(schemas.media, key, language, sizes)

const document = (key: string) => resolveDocument(schemas.documents, key)
---

<Layout
  site={schemas.site}
  meta={entry.page.meta}
  language={language}
  route={entry.route}
  support={support}
  image={image}
  document={document}
  chrome={content}
  pages={pages}
  sections={sections}
  business={business}
>
  {
    sections.map((section, index) => {
      const Block = components[section.type] ?? blocks[section.type]
      return (
        <Block
          props={section.props}
          language={language}
          image={image}
          document={document}
          heading={headingOf(index)}
        />
      )
    })
  }
</Layout>
