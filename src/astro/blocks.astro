---
// Le banc de blocs : tous les blocs disponibles sur une page, dans les tokens
// réels du site.
//
// Régler une direction artistique en rechargeant la page d’accueil, c’est
// régler deux blocs sur cinq. Ici ils y sont tous — ceux du socle et ceux du
// dépôt — remplis de valeurs dérivées de leurs descripteurs : un bloc écrit ce
// matin apparaît sans que rien n’ait été déclaré.
//
// Un bloc qui porte une variante bureau y est deux fois, l’un sous l’autre :
// c’est le seul endroit où les deux rendus d’une même section se comparent
// sans changer d’onglet ni de largeur de fenêtre.
//
// Le chrome entoure la page comme partout ailleurs : il se règle donc ici, à
// côté des blocs qu’il encadre, plutôt qu’en rechargeant l’accueil.
//
// La route n’existe que sous `astro dev` : elle n’est injectée nulle part
// ailleurs, et aucune version publiée ne la porte.
import {
  blocks,
  business,
  chromeContent,
  desktop,
  documents,
  media,
  pages,
  registry,
  site,
} from 'virtual:basalte'
import { sampleValues } from '../fields/sample.js'
import { resolveDocument, resolveImage } from '../media/resolve.js'
import { DEFAULT_SUPPORT } from '../render/supports.js'
import Layout from './Layout.astro'

export const prerender = false

const language = site.languages.default.code

const context = {
  languages: site.languages.all.map((entry) => entry.code),
  ...(Object.keys(media)[0] === undefined
    ? {}
    : { image: Object.keys(media)[0] }),
  ...(Object.keys(documents)[0] === undefined
    ? {}
    : { document: Object.keys(documents)[0] }),
}

const bench = Object.values(registry)
  .filter((definition) => blocks[definition.name] !== undefined)
  .sort((a, b) => a.name.localeCompare(b.name))
  .flatMap((definition) => {
    const props = sampleValues(definition.fields, context)
    const variant = desktop[definition.name]

    return variant === undefined
      ? [{ definition, props, support: '', component: blocks[definition.name] }]
      : [
          {
            definition,
            props,
            support: ' — mobile',
            component: blocks[definition.name],
          },
          { definition, props, support: ' — bureau', component: variant },
        ]
  })

const meta = {
  title: { [language]: `Blocs — ${site.name}` },
  description: { [language]: '' },
  image: '',
}

const image = (key: string, sizes?: string) =>
  resolveImage(media, key, language, sizes)

const document = (key: string) => resolveDocument(documents, key)
---

<Layout
  site={site}
  meta={meta}
  language={language}
  route="/__blocs"
  support={DEFAULT_SUPPORT}
  image={image}
  document={document}
  chrome={chromeContent}
  pages={pages.map((page) => ({ name: page.name, route: page.route }))}
  sections={[]}
  business={business}
  indexable={false}
>
  <div class="bench__intro">
    <p>
      {bench.length} bloc{bench.length > 1 ? 's' : ''} disponible{
        bench.length > 1 ? 's' : ''
      }, remplis de valeurs d’exemple. Cette page n’existe que sous <code
        >npm run dev</code
      >.
    </p>
  </div>

  {
    bench.map((entry) => {
      const Block = entry.component
      return (
        <section class="bench__block">
          <p class="bench__name">
            {entry.definition.name} — {entry.definition.label}
            {entry.support}
          </p>
          <Block
            props={entry.props}
            language={language}
            image={image}
            document={document}
            heading="h2"
          />
        </section>
      )
    })
  }
</Layout>

<style>
  .bench__intro {
    padding: var(--space-5);
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: var(--text-sm);
  }

  .bench__intro p {
    max-width: var(--width-content);
    margin: 0 auto;
  }

  .bench__name {
    max-width: var(--width-wide);
    margin: 0 auto;
    padding: var(--space-6) var(--space-5) 0;
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
