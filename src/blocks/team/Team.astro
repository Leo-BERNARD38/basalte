---
// Les personnes de l’entreprise. Le nom n’est pas traduisible et la fonction
// l’est : on ne traduit pas quelqu’un, on traduit son métier.
import { pick } from '../../fields/translate.js'
import type { BlockProps } from '../define.js'
import schema from './schema.js'

type Props = BlockProps<(typeof schema)['fields']>

const { props, language, image, heading } = Astro.props

const Title = heading
const ItemTitle = heading === 'h1' ? 'h2' : 'h3'

const title = pick(props.title, language)
const intro = pick(props.intro, language)

const items = props.items.map((item) => ({
  name: item.name,
  role: pick(item.role, language),
  body: pick(item.body, language),
  portrait: image(item.image, '(min-width: 48rem) 16rem, 60vw'),
}))
---

<section class="team">
  <div class="team__inner">
    {
      (title !== '' || intro !== '') && (
        <div class="team__head">
          {title !== '' && <Title class="team__title">{title}</Title>}
          {intro !== '' && <p class="team__intro">{intro}</p>}
        </div>
      )
    }
    <ul class="team__list">
      {
        items.map((item) => (
          <li class="team__item">
            {item.portrait !== undefined && (
              <img
                class="team__portrait"
                src={item.portrait.src}
                srcset={item.portrait.srcset}
                sizes={item.portrait.sizes}
                width={item.portrait.width}
                height={item.portrait.height}
                alt={item.portrait.alt}
                style={`object-position:${item.portrait.objectPosition}`}
                loading="lazy"
                decoding="async"
              />
            )}
            <ItemTitle class="team__name">{item.name}</ItemTitle>
            {item.role !== '' && <p class="team__role">{item.role}</p>}
            {item.body !== '' && <p class="team__body">{item.body}</p>}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .team {
    padding-block: clamp(var(--space-7), 6vw, var(--space-9));
    padding-inline: var(--space-5);
    background: var(--color-bg);
  }

  .team__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-6), 5vw, var(--space-8));
    max-width: var(--width-wide);
    margin-inline: auto;
  }

  .team__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--width-content);
    margin-inline: auto;
    text-align: center;
  }

  .team__title {
    margin: 0;
    font-family: var(--font-title);
    font-size: clamp(var(--text-2xl), 5vw, var(--text-3xl));
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .team__intro {
    margin: 0;
    color: var(--color-muted);
    font-size: clamp(var(--text-base), 2.5vw, var(--text-lg));
    line-height: 1.55;
  }

  .team__list {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .team__item {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--space-2);
  }

  .team__portrait {
    width: 12rem;
    margin-bottom: var(--space-3);
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .team__name {
    margin: 0;
    font-family: var(--font-title);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .team__role {
    margin: 0;
    color: var(--color-accent);
    font-size: var(--text-sm);
  }

  .team__body {
    margin: var(--space-2) 0 0;
    color: var(--color-muted);
    line-height: 1.55;
  }

  @media (min-width: 48rem) {
    .team__list {
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    }

    .team__portrait {
      width: 100%;
    }
  }
</style>
