---
// Le tableau comparatif, rendu mobile — celui qui existe toujours (D104).
//
// Deux colonnes, et pas un nombre libre : une liste de valeurs par ligne
// devrait rester alignée sur une liste de colonnes, et rien dans le panel ne
// saurait le tenir. Deux le sont par construction.
//
// Sur téléphone il n’y a pas de tableau : une légende nomme les deux colonnes
// une fois, puis chaque ligne devient une carte qui redit à quoi ses deux
// valeurs se rapportent. Le bureau en fait un vrai tableau.
import { pick } from '../../fields/translate.js'
import type { BlockProps } from '../define.js'
import schema from './schema.js'

type Props = BlockProps<(typeof schema)['fields']>

const { props, language, heading } = Astro.props

const Title = heading

const title = pick(props.title, language)
const intro = pick(props.intro, language)

const left = {
  name: pick(props.left.name, language),
  note: pick(props.left.note, language),
}
const right = {
  name: pick(props.right.name, language),
  note: pick(props.right.note, language),
}

const rows = props.rows.map((row) => ({
  label: pick(row.label, language),
  left: pick(row.left, language),
  right: pick(row.right, language),
}))
---

<section class="comparison">
  <div class="comparison__inner">
    {
      (title !== '' || intro !== '') && (
        <div class="comparison__head">
          {title !== '' && <Title class="comparison__title">{title}</Title>}
          {intro !== '' && <p class="comparison__intro">{intro}</p>}
        </div>
      )
    }

    <div class="comparison__legend">
      <p class="comparison__column comparison__column--mine">
        <span class="comparison__column-name">{left.name}</span>
        {
          left.note !== '' && (
            <span class="comparison__column-note">{left.note}</span>
          )
        }
      </p>
      <p class="comparison__column">
        <span class="comparison__column-name">{right.name}</span>
        {
          right.note !== '' && (
            <span class="comparison__column-note">{right.note}</span>
          )
        }
      </p>
    </div>

    <ul class="comparison__rows">
      {
        rows.map((row) => (
          <li class="comparison__row">
            <p class="comparison__label">{row.label}</p>
            <dl class="comparison__values">
              <div class="comparison__value comparison__value--mine">
                <dt>{left.name}</dt>
                <dd>{row.left}</dd>
              </div>
              <div class="comparison__value">
                <dt>{right.name}</dt>
                <dd>{row.right}</dd>
              </div>
            </dl>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .comparison {
    padding-block: clamp(var(--space-7), 6vw, var(--space-9));
    padding-inline: var(--space-5);
    background: var(--color-bg);
  }

  .comparison__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-5), 5vw, var(--space-7));
    max-width: var(--width-content);
    margin-inline: auto;
  }

  .comparison__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    text-align: center;
  }

  .comparison__title {
    margin: 0;
    font-family: var(--font-title);
    font-size: clamp(var(--text-2xl), 5vw, var(--text-3xl));
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .comparison__intro {
    margin: 0;
    color: var(--color-muted);
    font-size: clamp(var(--text-base), 2.5vw, var(--text-lg));
    line-height: 1.55;
  }

  .comparison__legend {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .comparison__column {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .comparison__column--mine {
    border-color: var(--color-accent);
  }

  .comparison__column-name {
    font-family: var(--font-title);
    font-weight: 600;
  }

  .comparison__column-note {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .comparison__rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .comparison__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .comparison__label {
    margin: 0;
    font-weight: 600;
  }

  .comparison__values {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
  }

  .comparison__value {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .comparison__value dt {
    color: var(--color-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .comparison__value dd {
    margin: 0;
    color: var(--color-muted);
  }

  .comparison__value--mine dd {
    color: var(--color-fg);
    font-weight: 500;
  }
</style>
