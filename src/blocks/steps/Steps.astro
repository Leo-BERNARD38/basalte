---
// Une suite d’étapes, où l’ordre porte le sens — c’est ce qui la sépare de la
// liste de points. Le numéro est un compteur CSS sur un `ol` : le client
// n’en saisit aucun, et en insérer une au milieu renumérote tout le reste.
import { pick } from '../../fields/translate.js'
import type { BlockProps } from '../define.js'
import schema from './schema.js'

type Props = BlockProps<(typeof schema)['fields']>

const { props, language, heading } = Astro.props

const Title = heading
const ItemTitle = heading === 'h1' ? 'h2' : 'h3'

const title = pick(props.title, language)
const intro = pick(props.intro, language)
---

<section class="steps">
  <div class="steps__inner">
    {
      (title !== '' || intro !== '') && (
        <div class="steps__head">
          {title !== '' && <Title class="steps__title">{title}</Title>}
          {intro !== '' && <p class="steps__intro">{intro}</p>}
        </div>
      )
    }
    <ol class="steps__list">
      {
        props.items.map((item) => (
          <li class="steps__item">
            <ItemTitle class="steps__item-title">
              {pick(item.title, language)}
            </ItemTitle>
            {pick(item.body, language) !== '' && (
              <p class="steps__item-body">{pick(item.body, language)}</p>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    padding-block: clamp(var(--space-7), 6vw, var(--space-9));
    padding-inline: var(--space-5);
    background: var(--color-bg);
  }

  .steps__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-6), 5vw, var(--space-8));
    max-width: var(--width-wide);
    margin-inline: auto;
  }

  .steps__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--width-content);
    margin-inline: auto;
    text-align: center;
  }

  .steps__title {
    margin: 0;
    font-family: var(--font-title);
    font-size: clamp(var(--text-2xl), 5vw, var(--text-3xl));
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .steps__intro {
    max-width: var(--width-content);
    margin: 0;
    color: var(--color-muted);
    font-size: clamp(var(--text-base), 2.5vw, var(--text-lg));
    line-height: 1.55;
  }

  .steps__list {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps__item {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--space-3);
    counter-increment: step;
  }

  /* Le rang porte le numéro : rien ne le saisit, rien ne peut donc le
     désaccorder de l’ordre des étapes. */
  .steps__item::before {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-accent-fg);
    font-family: var(--font-title);
    font-size: var(--text-sm);
    font-weight: 600;
    content: counter(step);
  }

  .steps__item-title {
    margin: 0;
    font-family: var(--font-title);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .steps__item-body {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.55;
  }

  @media (min-width: 48rem) {
    .steps__list {
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
      gap: var(--space-7) var(--space-6);
    }
  }
</style>
