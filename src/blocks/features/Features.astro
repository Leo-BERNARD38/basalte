---
import { pick } from '../../fields/translate.js'
import type { BlockProps } from '../define.js'
import schema from './schema.js'

type Props = BlockProps<(typeof schema)['fields']>

const { props, language, heading } = Astro.props

const Title = heading
const ItemTitle = heading === 'h1' ? 'h2' : 'h3'

const title = pick(props.title, language)
---

<section class="features">
  <div class="features__inner">
    {title !== '' && <Title class="features__title">{title}</Title>}
    <ul class="features__list">
      {
        props.items.map((item) => (
          <li class="features__item">
            <ItemTitle class="features__item-title">
              {pick(item.title, language)}
            </ItemTitle>
            {pick(item.body, language) !== '' && (
              <p class="features__item-body">{pick(item.body, language)}</p>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .features {
    padding-block: clamp(var(--space-7), 6vw, var(--space-9));
    padding-inline: var(--space-5);
    background: var(--color-bg);
  }

  .features__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-6), 5vw, var(--space-8));
    max-width: var(--width-wide);
    margin-inline: auto;
  }

  .features__title {
    max-width: var(--width-content);
    margin-inline: auto;
    margin-block: 0;
    text-align: center;
    font-family: var(--font-title);
    font-size: clamp(var(--text-2xl), 5vw, var(--text-3xl));
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .features__list {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .features__item-title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-title);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .features__item-body {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.55;
  }

  @media (min-width: 48rem) {
    .features__list {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-7) var(--space-6);
    }
  }
</style>
