---
// Une rangée de logos. Chacun garde ses proportions dans une boîte de hauteur
// commune : sans cela, un logo carré écrase la ligne qu’un logo large tient.
//
// Le lien est facultatif, et il est externe : une marque citée pointe vers son
// propre site, jamais vers une page d’ici.
import { pick } from '../../fields/translate.js'
import type { BlockProps } from '../define.js'
import schema from './schema.js'

type Props = BlockProps<(typeof schema)['fields']>

const { props, language, image, heading } = Astro.props

const Title = heading

const title = pick(props.title, language)

const items = props.items.flatMap((item) => {
  const resolved = image(item.image, '12rem')

  return resolved === undefined ? [] : [{ href: item.href, resolved }]
})
---

<section class="logos">
  <div class="logos__inner">
    {title !== '' && <Title class="logos__title">{title}</Title>}
    <ul class="logos__list">
      {
        items.map((item) => (
          <li class="logos__item">
            {item.href === '' ? (
              <img
                class="logos__image"
                src={item.resolved.src}
                srcset={item.resolved.srcset}
                sizes={item.resolved.sizes}
                width={item.resolved.width}
                height={item.resolved.height}
                alt={item.resolved.alt}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <a class="logos__link" href={item.href} rel="noopener">
                <img
                  class="logos__image"
                  src={item.resolved.src}
                  srcset={item.resolved.srcset}
                  sizes={item.resolved.sizes}
                  width={item.resolved.width}
                  height={item.resolved.height}
                  alt={item.resolved.alt}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .logos {
    padding-block: clamp(var(--space-6), 6vw, var(--space-8));
    padding-inline: var(--space-5);
    background: var(--color-surface);
  }

  .logos__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: var(--width-wide);
    margin-inline: auto;
  }

  .logos__title {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-title);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-align: center;
    text-transform: uppercase;
  }

  .logos__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(var(--space-5), 5vw, var(--space-7));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Une rangée de marques doit se lire comme une rangée, pas comme une
     collection de couleurs : le gris les met au même niveau, et le survol rend
     la sienne à celle qu’on regarde. */
  .logos__image {
    display: block;
    width: auto;
    max-height: 2.25rem;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.6;
    transition:
      filter 0.2s ease,
      opacity 0.2s ease;
  }

  .logos__link:hover .logos__image {
    filter: none;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .logos__image {
      transition: none;
    }
  }
</style>
