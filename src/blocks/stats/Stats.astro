---
// Des nombres alignés, sans titre d’item : le chiffre est lu avant son
// libellé, et l’ordre de lecture doit être celui-là. Le `dl` le dit —
// la valeur est le terme, le libellé sa définition.
import { pick } from '../../fields/translate.js'
import type { BlockProps } from '../define.js'
import schema from './schema.js'

type Props = BlockProps<(typeof schema)['fields']>

const { props, language, heading } = Astro.props

const Title = heading

const title = pick(props.title, language)
---

<section class="stats">
  <div class="stats__inner">
    {title !== '' && <Title class="stats__title">{title}</Title>}
    <dl class="stats__list">
      {
        props.items.map((item) => (
          <div class="stats__item">
            <dt class="stats__value">{pick(item.value, language)}</dt>
            <dd class="stats__label">{pick(item.label, language)}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .stats {
    padding-block: clamp(var(--space-7), 6vw, var(--space-9));
    padding-inline: var(--space-5);
    background: var(--color-surface);
  }

  .stats__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-6), 5vw, var(--space-8));
    max-width: var(--width-wide);
    margin-inline: auto;
  }

  .stats__title {
    max-width: var(--width-content);
    margin-inline: auto;
    margin-block: 0;
    text-align: center;
    font-family: var(--font-title);
    font-size: clamp(var(--text-2xl), 5vw, var(--text-3xl));
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .stats__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-7) var(--space-5);
    margin: 0;
    text-align: center;
  }

  .stats__value {
    font-family: var(--font-title);
    font-size: clamp(var(--text-3xl), 8vw, var(--text-4xl));
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .stats__label {
    margin: var(--space-3) 0 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  @media (min-width: 48rem) {
    .stats__list {
      grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    }
  }
</style>
