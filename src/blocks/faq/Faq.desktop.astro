---
// La variante bureau des questions fréquentes : le titre à gauche, les
// questions à droite, sans une seule media query.
//
// Le mobile reste la référence : ce fichier ne peut rien afficher que
// « Faq.astro » n’affiche pas (`src/render/parity.ts`). Les données
// structurées, elles, ne sont pas ici — elles sont déclarées dans le schéma,
// ce qui rend impossible qu’elles diffèrent d’un rendu à l’autre (D121).
import { renderRichtext } from '../../fields/richtext.js'
import { pick } from '../../fields/translate.js'
import type { BlockProps } from '../define.js'
import schema from './schema.js'

type Props = BlockProps<(typeof schema)['fields']>

const { props, language, heading } = Astro.props

const Title = heading
const QuestionTitle = heading === 'h1' ? 'h2' : 'h3'

const title = pick(props.title, language)

const items = props.items
  .map((item) => ({
    question: pick(item.question, language),
    answer: renderRichtext(
      pick(item.answer, language),
      schema.fields.items.of.answer,
    ),
  }))
  .filter((item) => item.question !== '')
---

<section class="faq">
  <div class="faq__inner">
    <div class="faq__aside">
      {title !== '' && <Title class="faq__title">{title}</Title>}
    </div>
    <div class="faq__list">
      {
        items.map((item) => (
          <details class="faq__item">
            <summary class="faq__question">
              <QuestionTitle class="faq__question-text">
                {item.question}
              </QuestionTitle>
            </summary>
            <div class="faq__answer" set:html={item.answer} />
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    padding: var(--space-8) var(--space-6);
    background: var(--color-bg);
    color: var(--color-fg);
  }

  .faq__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--space-7);
    align-items: start;
    max-width: var(--width-wide);
    margin-inline: auto;
  }

  .faq__title {
    margin: 0;
    font-family: var(--font-title);
    font-size: var(--text-2xl);
    line-height: 1.2;
  }

  .faq__list {
    display: flex;
    flex-direction: column;
  }

  .faq__item {
    padding: var(--space-4) 0;
  }

  .faq__item + .faq__item {
    border-top: 1px solid var(--color-border);
  }

  .faq__question {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 44px;
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question::after {
    flex: none;
    order: 2;
    width: 0.55rem;
    height: 0.55rem;
    margin-inline-start: auto;
    border-right: 2px solid var(--color-muted);
    border-bottom: 2px solid var(--color-muted);
    rotate: 45deg;
    translate: 0 -0.15rem;
    content: '';
  }

  .faq__item[open] .faq__question::after {
    rotate: -135deg;
    translate: 0 0.15rem;
  }

  .faq__question-text {
    margin: 0;
    font-family: var(--font-title);
    font-size: var(--text-xl);
    line-height: 1.3;
  }

  .faq__answer {
    max-width: var(--width-content);
    padding-top: var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-base);
  }

  .faq__answer :global(p),
  .faq__answer :global(ul),
  .faq__answer :global(ol) {
    margin: 0 0 var(--space-3);
  }

  .faq__answer :global(:last-child) {
    margin-bottom: 0;
  }

  .faq__answer :global(li) {
    margin-bottom: var(--space-2);
  }

  .faq__answer :global(a) {
    color: var(--color-accent);
  }
</style>
