---
// Le bandeau de relance. Il porte la couleur d’accent sur toute sa largeur :
// c’est le seul bloc du socle qui inverse les valeurs, et c’est ce qui le
// détache d’une page par ailleurs claire.
import { pick } from '../../fields/translate.js'
import type { BlockProps } from '../define.js'
import schema from './schema.js'

type Props = BlockProps<(typeof schema)['fields']>

const { props, language, heading } = Astro.props

const Title = heading

const title = pick(props.title, language)
const body = pick(props.body, language)
const label = pick(props.cta.label, language)
const href = props.cta.href
---

<section class="cta">
  <div class="cta__inner">
    <Title class="cta__title">{title}</Title>
    {body !== '' && <p class="cta__body">{body}</p>}
    {
      label !== '' && href !== '' && (
        <a class="button button--invert cta__button" href={href}>
          {label}
        </a>
      )
    }
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(var(--space-8), 10vw, var(--space-10));
    padding-inline: var(--space-5);
    background: var(--color-contrast);
    color: var(--color-contrast-fg);
  }

  .cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    max-width: var(--width-content);
    margin-inline: auto;
    text-align: center;
  }

  .cta__title {
    margin: 0;
    font-family: var(--font-title);
    font-size: clamp(var(--text-2xl), 6vw, var(--text-4xl));
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .cta__body {
    margin: 0;
    font-size: clamp(var(--text-base), 3vw, var(--text-lg));
    line-height: 1.5;
    opacity: 0.75;
  }

  .cta__button {
    margin-top: var(--space-2);
  }
</style>
