---
// Les formules, côte à côte. Aucune n’est mise en avant : le socle n’a pas de
// champ pour le dire, et une mise en avant décidée par le rendu mentirait dès
// que le client réordonne ses formules.
import { renderRichtext } from '../../fields/richtext.js'
import { pick } from '../../fields/translate.js'
import type { BlockProps } from '../define.js'
import schema from './schema.js'

type Props = BlockProps<(typeof schema)['fields']>

const { props, language, heading } = Astro.props

const Title = heading
const ItemTitle = heading === 'h1' ? 'h2' : 'h3'

const title = pick(props.title, language)
const intro = pick(props.intro, language)

const items = props.items.map((item) => ({
  name: pick(item.name, language),
  price: pick(item.price, language),
  note: pick(item.note, language),
  body: renderRichtext(pick(item.body, language), schema.fields.items.of.body),
  label: pick(item.cta.label, language),
  href: item.cta.href,
}))
---

<section class="pricing">
  <div class="pricing__inner">
    {
      (title !== '' || intro !== '') && (
        <div class="pricing__head">
          {title !== '' && <Title class="pricing__title">{title}</Title>}
          {intro !== '' && <p class="pricing__intro">{intro}</p>}
        </div>
      )
    }
    <ul class="pricing__list">
      {
        items.map((item) => (
          <li class="pricing__item">
            <ItemTitle class="pricing__name">{item.name}</ItemTitle>
            <p class="pricing__price">
              {item.price}
              {item.note !== '' && (
                <span class="pricing__note">{item.note}</span>
              )}
            </p>
            {item.body !== '' && (
              <div class="pricing__body" set:html={item.body} />
            )}
            {item.label !== '' && item.href !== '' && (
              <a class="button button--quiet pricing__cta" href={item.href}>
                {item.label}
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .pricing {
    padding-block: clamp(var(--space-7), 6vw, var(--space-9));
    padding-inline: var(--space-5);
    background: var(--color-bg);
  }

  .pricing__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-6), 5vw, var(--space-8));
    max-width: var(--width-wide);
    margin-inline: auto;
  }

  .pricing__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--width-content);
    margin-inline: auto;
    text-align: center;
  }

  .pricing__title {
    margin: 0;
    font-family: var(--font-title);
    font-size: clamp(var(--text-2xl), 5vw, var(--text-3xl));
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .pricing__intro {
    margin: 0;
    color: var(--color-muted);
    font-size: clamp(var(--text-base), 2.5vw, var(--text-lg));
    line-height: 1.55;
  }

  .pricing__list {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pricing__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .pricing__name {
    margin: 0;
    font-family: var(--font-title);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .pricing__price {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    font-family: var(--font-title);
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .pricing__note {
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: normal;
  }

  .pricing__body {
    color: var(--color-muted);
    line-height: 1.55;
  }

  .pricing__body :global(p) {
    margin: 0 0 var(--space-3);
  }

  .pricing__body :global(ul) {
    margin: 0;
    padding-left: var(--space-5);
  }

  .pricing__body :global(li) {
    margin-bottom: var(--space-2);
  }

  .pricing__cta {
    margin-top: auto;
  }

  @media (min-width: 48rem) {
    .pricing__list {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
      gap: var(--space-6);
    }
  }
</style>
