---
import { pick } from '../../fields/translate.js'
import type { BlockProps } from '../define.js'
import schema from './schema.js'

type Props = BlockProps<(typeof schema)['fields']>

const { props, language, image, heading } = Astro.props

const Title = heading

const title = pick(props.title, language)
const subtitle = pick(props.subtitle, language)
const label = pick(props.cta.label, language)
const href = props.cta.href
const illustration = image(props.image, '(min-width: 72rem) 72rem, 100vw')
---

<section class="hero">
  <div class="hero__inner">
    <Title class="hero__title">{title}</Title>
    {subtitle !== '' && <p class="hero__subtitle">{subtitle}</p>}
    {
      label !== '' && href !== '' && (
        <a class="hero__cta" href={href}>
          {label}
        </a>
      )
    }
  </div>
  {
    illustration !== undefined && (
      <img
        class="hero__image"
        src={illustration.src}
        srcset={illustration.srcset}
        sizes={illustration.sizes}
        width={illustration.width}
        height={illustration.height}
        alt={illustration.alt}
        style={`object-position:${illustration.objectPosition}`}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    )
  }
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
    padding: var(--space-8) var(--space-5) 0;
    background: var(--color-bg);
    color: var(--color-fg);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--width-content);
    margin-inline: auto;
  }

  .hero__title {
    margin: 0;
    font-family: var(--font-title);
    font-size: var(--text-3xl);
    line-height: 1.1;
  }

  .hero__subtitle {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-lg);
  }

  .hero__cta {
    align-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-accent-fg);
    font-size: var(--text-base);
    text-decoration: none;
  }

  .hero__cta:hover {
    text-decoration: underline;
  }

  .hero__image {
    width: 100%;
    max-width: var(--width-wide);
    margin-inline: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-md);
  }
</style>
