---
import { pick } from '../../fields/translate.js'
import type { BlockProps } from '../define.js'
import schema from './schema.js'

type Props = BlockProps<(typeof schema)['fields']>

const { props, language, image, heading } = Astro.props

const Title = heading

const title = pick(props.title, language)
const subtitle = pick(props.subtitle, language)
const label = pick(props.cta.label, language)
const href = props.cta.href
const illustration = image(props.image, '(min-width: 72rem) 72rem, 100vw')
---

<section class="hero">
  <div class="hero__inner">
    <Title class="hero__title">{title}</Title>
    {subtitle !== '' && <p class="hero__subtitle">{subtitle}</p>}
    {
      label !== '' && href !== '' && (
        <a class="button hero__cta" href={href}>
          {label}
        </a>
      )
    }
  </div>
  {
    illustration !== undefined && (
      <img
        class="hero__image"
        src={illustration.src}
        srcset={illustration.srcset}
        sizes={illustration.sizes}
        width={illustration.width}
        height={illustration.height}
        alt={illustration.alt}
        style={`object-position:${illustration.objectPosition}`}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    )
  }
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-6), 9vw, var(--space-8));
    padding-block: clamp(var(--space-7), 12vw, var(--space-9));
    padding-inline: var(--space-5);
    background: var(--color-bg);
    color: var(--color-fg);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    max-width: var(--width-content);
    margin-inline: auto;
    width: 100%;
    text-align: center;
  }

  .hero__title {
    margin: 0;
    font-family: var(--font-title);
    font-size: clamp(var(--text-3xl), 10vw, var(--text-4xl));
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .hero__subtitle {
    margin: 0;
    color: var(--color-muted);
    font-size: clamp(var(--text-lg), 4.5vw, var(--text-xl));
    line-height: 1.45;
  }

  .hero__cta {
    margin-top: var(--space-2);
  }

  .hero__image {
    width: 100%;
    max-width: var(--width-wide);
    margin-inline: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }
</style>
