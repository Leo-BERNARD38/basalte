---
// Les coordonnées telles que la fiche les porte. Chaque partie manquante
// disparaît : une fiche à moitié remplie donne une section plus courte, jamais
// une ligne vide.
//
// Le téléphone et l’email sont des liens : sur un téléphone, c’est ce qui
// sépare un appel d’une recopie à la main.
import { pick } from '../../fields/translate.js'
import { dayLabel, hasAddress } from '../../seo/business.js'
import type { BlockProps } from '../define.js'
import schema from './schema.js'

type Props = BlockProps<(typeof schema)['fields']>

const { props, language, heading, business } = Astro.props

const Title = heading
const ItemTitle = heading === 'h1' ? 'h2' : 'h3'

const title = pick(props.title, language)
const intro = pick(props.intro, language)

const address = hasAddress(business) ? business.address : undefined
const phone = business.phone.trim()
const email = business.email.trim()
const area = business.area.trim()

const hours = business.hours.filter(
  (entry) => entry.day !== '' && entry.opens !== '' && entry.closes !== '',
)
---

<section class="details">
  <div class="details__inner">
    {
      (title !== '' || intro !== '') && (
        <div class="details__head">
          {title !== '' && <Title class="details__title">{title}</Title>}
          {intro !== '' && <p class="details__intro">{intro}</p>}
        </div>
      )
    }
    <div class="details__columns">
      {
        (address !== undefined || phone !== '' || email !== '') && (
          <div>
            <ItemTitle class="details__heading">Nous joindre</ItemTitle>
            <address class="details__address">
              {address !== undefined && (
                <span class="details__line">
                  {address.street}
                  <br />
                  {address.postalCode} {address.city}
                  {address.country !== '' && (
                    <>
                      <br />
                      {address.country}
                    </>
                  )}
                </span>
              )}
              {phone !== '' && (
                <a
                  class="details__line"
                  href={`tel:${phone.replace(/\s/g, '')}`}
                >
                  {phone}
                </a>
              )}
              {email !== '' && (
                <a class="details__line" href={`mailto:${email}`}>
                  {email}
                </a>
              )}
              {area !== '' && <span class="details__area">{area}</span>}
            </address>
          </div>
        )
      }
      {
        hours.length > 0 && (
          <div>
            <ItemTitle class="details__heading">Horaires</ItemTitle>
            <dl class="details__hours">
              {hours.map((entry) => (
                <div class="details__slot">
                  <dt>{dayLabel(entry.day)}</dt>
                  <dd>
                    {entry.opens} – {entry.closes}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .details {
    padding-block: clamp(var(--space-7), 6vw, var(--space-9));
    padding-inline: var(--space-5);
    background: var(--color-surface);
  }

  .details__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-6), 5vw, var(--space-8));
    max-width: var(--width-wide);
    margin-inline: auto;
  }

  .details__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--width-content);
    margin-inline: auto;
    text-align: center;
  }

  .details__title {
    margin: 0;
    font-family: var(--font-title);
    font-size: clamp(var(--text-2xl), 5vw, var(--text-3xl));
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .details__intro {
    margin: 0;
    color: var(--color-muted);
    font-size: clamp(var(--text-base), 2.5vw, var(--text-lg));
    line-height: 1.55;
  }

  .details__columns {
    display: grid;
    gap: var(--space-6);
  }

  .details__heading {
    margin: 0 0 var(--space-3);
    font-family: var(--font-title);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .details__address {
    font-style: normal;
    line-height: 1.7;
  }

  .details__line {
    display: block;
  }

  /* Chaque coordonnée occupe sa ligne : un téléphone et une adresse email
     collés se lisent comme une seule chaîne. */
  a.details__line {
    display: flex;
    align-items: center;
    width: fit-content;
    min-height: 44px;
    color: var(--color-accent);
    text-decoration: none;
  }

  a.details__line:hover {
    text-decoration: underline;
  }

  .details__area {
    display: block;
    margin-top: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .details__hours {
    margin: 0;
  }

  .details__slot {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: var(--width-content);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .details__slot dt,
  .details__slot dd {
    margin: 0;
  }

  .details__slot dd {
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 48rem) {
    .details__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-8);
    }
  }
</style>
