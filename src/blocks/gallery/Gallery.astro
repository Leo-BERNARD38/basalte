---
import { pick } from '../../fields/translate.js'
import type { BlockProps } from '../define.js'
import schema from './schema.js'

type Props = BlockProps<(typeof schema)['fields']>

const { props, language, image, heading } = Astro.props

const Title = heading

const title = pick(props.title, language)
const sizes = '(min-width: 62rem) 22rem, (min-width: 40rem) 45vw, 100vw'

const items = props.images.flatMap((item) => {
  const resolved = image(item.image, sizes)

  return resolved === undefined
    ? []
    : [{ caption: pick(item.caption, language), resolved }]
})
---

<section class="gallery">
  <div class="gallery__inner">
    {title !== '' && <Title class="gallery__title">{title}</Title>}
    <ul class="gallery__list">
      {
        items.map((item) => (
          <li>
            <figure class="gallery__item">
              <img
                class="gallery__image"
                src={item.resolved.src}
                srcset={item.resolved.srcset}
                sizes={item.resolved.sizes}
                width={item.resolved.width}
                height={item.resolved.height}
                alt={item.resolved.alt}
                style={`object-position:${item.resolved.objectPosition}`}
                loading="lazy"
                decoding="async"
              />
              {item.caption !== '' && (
                <figcaption class="gallery__caption">{item.caption}</figcaption>
              )}
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .gallery {
    padding-block: clamp(var(--space-7), 6vw, var(--space-9));
    padding-inline: var(--space-5);
    background: var(--color-bg);
  }

  .gallery__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-6), 5vw, var(--space-8));
    max-width: var(--width-wide);
    margin-inline: auto;
  }

  .gallery__title {
    max-width: var(--width-content);
    margin-inline: auto;
    margin-block: 0;
    text-align: center;
    font-family: var(--font-title);
    font-size: clamp(var(--text-2xl), 5vw, var(--text-3xl));
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .gallery__list {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
  }

  .gallery__image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .gallery__caption {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  @media (min-width: 40rem) {
    .gallery__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 62rem) {
    .gallery__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }
</style>
